<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= @conversation.title.presence || "Conversation ##{@conversation.id}" %></title>
    <style>
      body { font-family: "Noto Sans CJK JP", "Hiragino Sans", sans-serif; color: #1e293b; line-height: 1.7; padding: 24px; }
      h1 { font-size: 20px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
      h2 { font-size: 14px; color: #0284c7; margin-top: 24px; }
      pre { background: #f1f5f9; padding: 12px; border-radius: 8px; overflow-x: auto; }
      code { font-family: monospace; }
      .meta { color: #64748b; font-size: 12px; }
      @media print {
        h2 { page-break-after: avoid; }
        pre { page-break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
